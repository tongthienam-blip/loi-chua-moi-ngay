# ============================================================================
# CẤU HÌNH BIẾN MÔI TRƯỜNG - NỀN TẢNG "LỜI CHÚA MỖI NGÀY"
# ============================================================================

# MÔI TRƯỜNG & DOMAIN
NODE_ENV=production
NEXT_PUBLIC_APP_URL=https://loichuamoingay.vn

# SUPABASE & POSTGRESQL DATABASE
# Cấu hình kết nối Supabase Cloud hoặc PostgreSQL cục bộ
NEXT_PUBLIC_SUPABASE_URL=https://your-project.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-key-here
SUPABASE_SERVICE_ROLE_KEY=your-secure-service-role-key-do-not-expose

# DATABASE CONNECTION STRING CHO PRISMA / DRIZZLE
DATABASE_URL=postgresql://bible_admin:SecureCatholicPass2026@localhost:5432/catholic_bible_db?schema=public

# BẢO MẬT & JWT AUTH
JWT_SECRET=catholic-bible-platform-secure-jwt-secret-key-2026
ADMIN_MASTER_PASSWORD=SuperAdminCatholic2026!#

# TRỢ LÝ AI HỌC HỎI KINH THÁNH (CHỈ CHẠY SERVER-SIDE, TUYỆT ĐỐI KHÔNG EXPOSE RA FRONTEND)
GEMINI_API_KEY=your-gemini-api-key-here
OPENAI_API_KEY=your-openai-api-key-here

# TÙY CHỌN BẢN QUYỀN & XÁC THỰC
NEXT_PUBLIC_ENABLE_TTS=true
NEXT_PUBLIC_DEFAULT_TRANSLATION=cgv
